+from __future__ import annotations
+import asyncio
+import logging
+from typing import Dict, List, Optional, Any, TYPE_CHECKING, Sequence
+
+from opentrons.config.types import RobotConfig
+from opentrons.types import Mount
+from ..simulation import ZMQSimulationClient, AxisMapper
+from ..types import Axis
+from .simulator import Simulator
+
+if TYPE_CHECKING:
+    from opentrons.drivers.rpi_drivers.dev_types import GPIODriverLike
+
+MODULE_LOG = logging.getLogger(__name__)
+
+
+class SimulationController(Simulator):
+    """Simulation backend that inherits pipette handling from Simulator
+    but redirects motion commands to Isaac Sim via ZMQ.
+
+    Simulator handles: pipette loading, instrument detection, configuration
+    SimulationController overrides: movement, homing, lights, halt (via ZMQ)
+    """
+
+    @classmethod
+    async def build(cls, config: Optional[RobotConfig] = None, **kwargs) -> SimulationController:
+        """Build a SimulationController with default attached instruments."""
+        from opentrons.hardware_control import modules
+
+        attached_instruments = {
+            Mount.LEFT: {"model": "p20_single_v2.1", "id": "sim-left-pipette"},
+            Mount.RIGHT: {"model": "p20_single_v2.1", "id": "sim-right-pipette"},
+        }
+        attached_modules: Dict[str, List[modules.SimulatingModule]] = {}
+
+        loop = asyncio.get_event_loop()
+        instance = await Simulator.build(
+            attached_instruments=attached_instruments,
+            attached_modules=attached_modules,
+            config=config,
+            loop=loop,
+            strict_attached_instruments=False,
+        )
+        # Re-class the Simulator instance as SimulationController
+        instance.__class__ = cls
+        instance._simulation_client = ZMQSimulationClient()
+        instance._axis_mapper = AxisMapper()
+        await instance._simulation_client.connect()
+        return instance
+
+    # --- Stubs for methods api.py expects on the backend ---
+
+    def start_gpio_door_watcher(self, loop, update_door_state):
+        """No-op for simulation."""
+        pass
+
+    async def watch(self, **kwargs):
+        """No-op for simulation."""
+        pass
+
+    # --- Override motion methods to use ZMQ ---
+
+    async def move(
+        self,
+        target_position: Dict[str, float],
+        home_flagged_axes: bool = True,
+        speed: Optional[float] = None,
+        axis_max_speeds: Optional[Dict[str, float]] = None,
+    ) -> None:
+        """Move robot axes to target positions via ZMQ."""
+        joint_commands = self._axis_mapper.convert_positions_to_joints(target_position)
+        if not joint_commands:
+            return
+        success = await self._simulation_client.move_joints(joint_commands)
+        if not success:
+            raise RuntimeError("Failed to execute movement in simulation")
+
+    async def home(self, axes: Optional[List[str]] = None) -> Dict[str, float]:
+        """Home axes via ZMQ."""
+        success = await self._simulation_client.home_robot()
+        if not success:
+            raise RuntimeError("Failed to home robot in simulation")
+        return await self.update_position()
+
+    async def fast_home(self, axes: Sequence[str], margin: float) -> Dict[str, float]:
+        """Fast home (simulation just uses regular home)."""
+        return await self.home(list(axes))
+
+    async def update_position(self) -> Dict[str, float]:
+        """Update position from ZMQ simulation."""
+        joint_positions = await self._simulation_client.get_joint_positions()
+        return self._axis_mapper.convert_joint_positions_to_axes(joint_positions)
+
+    def _unhomed_axes(self, axes: Sequence[str]) -> List[str]:
+        """Check homed status via ZMQ."""
+        homed = self._simulation_client.is_homed(list(axes))
+        return [] if homed else list(axes)
+
+    def is_homed(self, axes: Sequence[str]) -> bool:
+        """Check if axes are homed via ZMQ."""
+        return self._simulation_client.is_homed(list(axes))
+
+    # --- Override lights/halt to use ZMQ ---
+
+    def set_lights(self, button: Optional[bool], rails: Optional[bool]) -> None:
+        """Set lights via ZMQ simulation."""
+        if button is not None:
+            self._simulation_client.set_button_light(button)
+        if rails is not None:
+            self._simulation_client.set_rail_lights(rails)
+
+    def get_lights(self) -> Dict[str, bool]:
+        """Get light status from ZMQ simulation."""
+        return self._simulation_client.get_lights()
+
+    def pause(self) -> None:
+        """Pause robot movement via ZMQ."""
+        self._simulation_client.pause_robot()
+
+    def resume(self) -> None:
+        """Resume robot movement via ZMQ."""
+        self._simulation_client.resume_robot()
+
+    async def halt(self) -> None:
+        """Halt robot movement via ZMQ."""
+        await self._simulation_client.halt_robot()
+
+    async def hard_halt(self) -> None:
+        """Hard halt (same as halt for simulation)."""
+        await self.halt()
+
+    async def probe(self, axis: str, distance: float) -> Dict[str, float]:
+        """Probe axis via ZMQ."""
+        return self._simulation_client.probe_axis(axis, distance)
+
+    async def connect(self, port: Optional[str] = None) -> None:
+        """Connect (no-op -- ZMQ client already connected in build())."""
+        pass
+
+    async def clean_up(self) -> None:
+        """Clean up ZMQ resources."""
+        if hasattr(self, "_simulation_client"):
+            await self._simulation_client.disconnect()
